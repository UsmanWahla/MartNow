PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=replace_with_database_password
DB_NAME=login_signup_db
JWT_SECRET=replace_with_a_long_random_secret

# Required when running the platform seed.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password
SUPER_ADMIN_NAME=Platform Admin

# Public frontend origins allowed to send credentialed browser requests.
CORS_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false

# Optional marketplace configuration.
PLATFORM_DELIVERY_FEE=0
LOCATION_SEARCH_USER_AGENT=RetailPlatform/1.0 (admin@example.com)
